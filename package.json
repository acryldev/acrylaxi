{
  "name": "acrylaxi",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.1",
  "description": "HTML is the new markdown. ACRYL AXI (Agent External Interface) turns agent-generated HTML into an annotatable review surface.",
  "type": "module",
  "bin": {
    "acrylaxi": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "plugin.json",
    "skills/acrylaxi",
    "marketing/renders/acrylaxi-explainer.gif",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:skill": "node scripts/build-skill.js",
    "build:plugin": "node scripts/build-plugin.js",
    "check": "npm run build && npm run lint && npm run format:check && npm run typecheck && npm test && node scripts/build-skill.js --check && node scripts/build-plugin.js --check",
    "start": "node dist/cli.mjs",
    "lint": "eslint bin src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "upstream:status": "node scripts/pull-upstream.mjs --check",
    "upstream:pull": "node scripts/pull-upstream.mjs --pull"
  },
  "dependencies": {
    "@tailwindcss/browser": "4.2.4",
    "axi-sdk-js": "^0.1.8",
    "chokidar": "^4.0.3",
    "cross-spawn": "7.0.6",
    "daisyui": "^5.5.19",
    "express": "^5.2.1",
    "open": "^10.2.0",
    "parse5": "^8.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@types/node": "^25.6.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "mermaid": "11.12.1",
    "prettier": "^3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "axi",
    "agent",
    "cli",
    "html",
    "review",
    "collaboration",
    "acryl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acryldev/acrylaxi.git"
  },
  "bugs": {
    "url": "https://github.com/acryldev/acrylaxi/issues"
  },
  "homepage": "https://github.com/acryldev/acrylaxi#readme",
  "publishConfig": {
    "access": "public"
  }
}
